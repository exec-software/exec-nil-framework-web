        "175624f0f95b0a47a1b3b52f5b149f88802d3822b184325d0c20a1a7c132a687",
        "0598a3d8b5a82710dda54f05c4aa11fdd1c0aa5fafb216840fccbae323f07520",
        "22cd13d4f3251bfe1d793f401ddc6d489ee3421958920e873e7e0138c576a136",
        "a8365b6e6ed1daf56c41bae89ab089c03b671240ae103070480a7f271bdbad57",
        "d399f065c9f21e2fd51e2aeadb7768eab7e6e45e5150f31227c9711934a4d1d3",
        "d672408e0571636ea21092304eb31ba8fc1fbffc5d5ea6531d62b072714599db",
        "6d59f1b3a886e8cb813e77d1f0ca0ea63ed8aa8f52511c4a438efb6a4a51d1ff",
        "8e5ed1e6474d39bf1594411085e7a50c15aabaa768e633ebf0960ce20e84e336",
        "dd31e55fd954d9edc9e29f8e078387f0dd38e8ea832376311820de6322cdb0d1",
        "e051d1007607de494c073da3c29903d6c0abfee7a4c0609f560a340a1947b470"
    ]
    variable index as number is 0
    repeat while index is less than the length of widths
        value width is widths at index
        evaluate same-text with label being "SHA-256 binary pattern length " plus (nilweb.tests.harness::as-text with amount being width),
            actual being (sha256-hex with data being (patterned-bytes with width being width)),
            expected being expected at index
        set index to index plus 1
    end repeat
    give nothing
end paragraph


patterned-bytes receives width as number returns text begin paragraph
    variable data as text is ""
    variable index as number is 0
    repeat while index is less than width
        set data to data plus (nil.std.text::from_byte with code being (index times 73 plus 19) remainder 256)
        set index to index plus 1
    end repeat
    give data
end paragraph
