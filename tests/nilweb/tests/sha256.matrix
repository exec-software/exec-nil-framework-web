!!! Independent SHA-256 known answers. The two NIST message examples are at
!!! https://csrc.nist.gov/CSRC/media/Projects/Cryptographic-Standards-and-Guidelines/documents/examples/SHA256.pdf
!!! Other expected digests were computed with Python hashlib.sha256, including
!!! binary messages whose bytes are (index * 73 + 19) modulo 256.

book nilweb.tests.sha256

read nil.std.text
read everything from nilweb.crypto.sha256
read everything from nilweb.tests.harness


public run-sha256-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.crypto.sha256"
    evaluate same-text with label being "SHA-256 empty input",
        actual being (sha256-hex with data being ""),
        expected being "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    evaluate same-text with label being "SHA-256 NIST one-block message",
        actual being (sha256-hex with data being "abc"),
        expected being "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    evaluate same-text with label being "SHA-256 NIST two-block message",
        actual being (sha256-hex with data being "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
        expected being "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
    evaluate same-text with label being "SHA-256 112-byte multi-block message",
        actual being (sha256-hex with data being "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"),
        expected being "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1"
    evaluate same-text with label being "SHA-256 NUL is a byte, not a terminator",
        actual being (sha256-hex with data being (nil.std.text::from_byte with code being 0)),
        expected being "6e340b9cffb37a989ca544e6bb780a2c78901d3fb33738768511a30617afa01d"
    evaluate same-text with label being "SHA-256 high byte is not reencoded as Unicode",
        actual being (sha256-hex with data being (nil.std.text::from_byte with code being 255)),
        expected being "a8100ae6aa1940d0b663bb31cd466142ebbdbd5187131b92d93818987832eb89"
    evaluate same-text with label being "SHA-256 hashes UTF-8 bytes exactly",
        actual being (sha256-hex with data being "café 🌍"),
        expected being "2a51ea11819c3ccea2fb3cf397b809b1fb333b8d191698a5fb47d04cb40db1e4"
    evaluate same-text with label being "SHA-256 same-length changed contents",
        actual being (sha256-hex with data being "abd"),
        expected being "a52d159f262b2c6ddb724a61840befc36eb30c88877a4030b65cbe86298449c9"

    value widths as array of number is [1, 2, 3, 31, 32, 55, 56, 57, 63, 64, 65,
        119, 120, 121, 127, 128, 129, 255, 256, 257, 1024]
    value expected as array of text is [
        "ab897fbdedfa502b2d839b6a56100887dccdc507555c282e59589e06300a62e2",
        "c756bd104d1406ec2c380c268dbef88fd2082819c15a21c8644bcd8e8de4bc96",
