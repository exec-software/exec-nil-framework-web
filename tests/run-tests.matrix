    evaluate same-number with label being "weekday 2045753684719", actual being (civil-from-ms with at-ms being 2045753684719).weekday, expected being 0
    evaluate same-number with label being "round-trip 2045753684719", actual being (ms-from-http-date with stated being "Sun, 29 Oct 2034 16:54:44 GMT"), expected being 2045753684000
    evaluate same-text with label being "http 1591084311600", actual being (http-date with at-ms being 1591084311600), expected being "Tue, 02 Jun 2020 07:51:51 GMT"
    evaluate same-text with label being "iso 1591084311600", actual being (iso-instant with at-ms being 1591084311600), expected being "2020-06-02T07:51:51Z"
    evaluate same-text with label being "log 1591084311600", actual being (log-date with at-ms being 1591084311600), expected being "02/Jun/2020:07:51:51 +0000"
    evaluate same-number with label being "weekday 1591084311600", actual being (civil-from-ms with at-ms being 1591084311600).weekday, expected being 2
    evaluate same-number with label being "round-trip 1591084311600", actual being (ms-from-http-date with stated being "Tue, 02 Jun 2020 07:51:51 GMT"), expected being 1591084311000
    evaluate same-text with label being "http 1092209182637", actual being (http-date with at-ms being 1092209182637), expected being "Wed, 11 Aug 2004 07:26:22 GMT"
    evaluate same-text with label being "iso 1092209182637", actual being (iso-instant with at-ms being 1092209182637), expected being "2004-08-11T07:26:22Z"
    evaluate same-text with label being "log 1092209182637", actual being (log-date with at-ms being 1092209182637), expected being "11/Aug/2004:07:26:22 +0000"
    evaluate same-number with label being "weekday 1092209182637", actual being (civil-from-ms with at-ms being 1092209182637).weekday, expected being 3
    evaluate same-number with label being "round-trip 1092209182637", actual being (ms-from-http-date with stated being "Wed, 11 Aug 2004 07:26:22 GMT"), expected being 1092209182000
    evaluate same-text with label being "http 793685816359", actual being (http-date with at-ms being 793685816359), expected being "Sat, 25 Feb 1995 04:16:56 GMT"
    evaluate same-text with label being "iso 793685816359", actual being (iso-instant with at-ms being 793685816359), expected being "1995-02-25T04:16:56Z"
    evaluate same-text with label being "log 793685816359", actual being (log-date with at-ms being 793685816359), expected being "25/Feb/1995:04:16:56 +0000"
    evaluate same-number with label being "weekday 793685816359", actual being (civil-from-ms with at-ms being 793685816359).weekday, expected being 6
    evaluate same-number with label being "round-trip 793685816359", actual being (ms-from-http-date with stated being "Sat, 25 Feb 1995 04:16:56 GMT"), expected being 793685816000

    !!! Malformed dates are minus one and never the epoch, which a comparison
    !!! would read as 1970 and treat as "not modified since the dawn of time".
    evaluate same-number with label being "an empty date is refused",
        actual being (ms-from-http-date with stated being ""), expected being 0 minus 1
    evaluate same-number with label being "a short date is refused",
        actual being (ms-from-http-date with stated being "Sun, 06 Nov 1994"), expected being 0 minus 1
    evaluate same-number with label being "a date without GMT is refused",
        actual being (ms-from-http-date with stated being "Sun, 06 Nov 1994 08:49:37 UTC"), expected being 0 minus 1
    evaluate same-number with label being "an unknown month is refused",
        actual being (ms-from-http-date with stated being "Sun, 06 Zzz 1994 08:49:37 GMT"), expected being 0 minus 1
    evaluate same-number with label being "a non-numeric day is refused",
        actual being (ms-from-http-date with stated being "Sun, ab Nov 1994 08:49:37 GMT"), expected being 0 minus 1
    evaluate same-number with label being "an hour of 24 is refused",
        actual being (ms-from-http-date with stated being "Sun, 06 Nov 1994 24:49:37 GMT"), expected being 0 minus 1
    evaluate same-number with label being "an obsolete RFC 850 date is refused rather than misread",
        actual being (ms-from-http-date with stated being "Sunday, 06-Nov-94 08:49:37 GMT"), expected being 0 minus 1

    !!! A pre-epoch stamp is clamped, not formatted by truncating division
    !!! that would be a day out for exactly the inputs nobody tests.
    evaluate same-text with label being "a pre-epoch stamp clamps to the epoch",
        actual being (http-date with at-ms being 0 minus 86400000), expected being "Thu, 01 Jan 1970 00:00:00 GMT"
    give nothing
end paragraph

log-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.log.access"
    value log-file is "tests/tmp-access.log"
    value err-file is "tests/tmp-error.log"
    evaluate nil.std.io::delete with path being log-file
    evaluate nil.std.io::delete with path being err-file

    !!! Off by default: nothing is written until a path is given.
    evaluate log-to with access-file being "", error-file being ""
    evaluate is-true with label being "logging is off until asked", actual being not (logging-access with nothing)
    value sunk is make-request with verb being request-method.Get, target being "/", fields being (no-headers with nothing), body being ""
    evaluate record-request with client being "192.0.2.10:40001", request being sunk, code being 200, bytes being 5, at-ms being 784111777000
    evaluate same-number with label being "a request with no log path buffers nothing",
        actual being (buffered-count with nothing), expected being 0

    evaluate log-to with access-file being log-file, error-file being err-file
    evaluate is-true with label being "logging is on once a path is given", actual being (logging-access with nothing)

    !!! The Combined Log Format, field by field.
    variable fields is no-headers with nothing
    set fields to set-field with fields being fields, name being "Referer", content being "http://example.com/from"
    set fields to set-field with fields being fields, name being "User-Agent", content being "curl/8.5.0"
    value logged is make-request with verb being request-method.Get, target being "/posts?page=2",
        fields being fields, body being ""
    evaluate record-request with client being "127.0.0.1:54321", request being logged,
        code being 200, bytes being 1234, at-ms being 784111777000
    evaluate same-number with label being "a line is buffered", actual being (buffered-count with nothing), expected being 1
    evaluate flush-now with nothing
    evaluate same-number with label being "flushing empties the buffer", actual being (buffered-count with nothing), expected being 0

    value written is nil.std.io::read_text with path being log-file
    consider written
        when Result.Ok holding body then begin block
            evaluate same-text with label being "the line is exactly the Combined Log Format",
                actual being (nil.std.text::trim with s being body),
                expected being "127.0.0.1:54321 - - [06/Nov/1994:08:49:37 +0000] "
                    plus quote plus "GET /posts?page=2 HTTP/1.1" plus quote
                    plus " 200 1234 " plus quote plus "http://example.com/from" plus quote
                    plus " " plus quote plus "curl/8.5.0" plus quote
        end block
        otherwise evaluate is-true with label being "the access log was written", actual being false
    end consider

    !!! A missing field is a dash, which is what every reader of this format
    !!! expects and what distinguishes "absent" from "empty".
    evaluate same-text with label being "an absent field logs as a dash",
        actual being (shown-for with raw being ""), expected being "-"

    !!! Log forging. A newline in a header would end the line and start one of
    !!! the attacker's choosing -- a forged entry in a file read as evidence.
    evaluate is-true with label being "a newline in a header cannot end the log line",
        actual being not (nil.std.text::contains with s being
            (one-line with raw being ("evil" plus newline plus "192.0.2.10 - - [x] fake")), needle being newline)
    evaluate is-true with label being "a quote in a header cannot close the field early",
        actual being not (nil.std.text::contains with s being
            (one-line with raw being ("a" plus quote plus "b")), needle being quote)
    evaluate is-true with label being "a backslash is removed too",
        actual being not (nil.std.text::contains with s being (one-line with raw being "a\\b"), needle being "\\")
    evaluate same-number with label being "sanitising does not change the length a reader sees",
        actual being (nil.std.text::length with s being (one-line with raw being ("a" plus quote plus "b"))), expected being 3
    evaluate same-text with label being "an escape sequence cannot colour a terminal",
        actual being (one-line with raw being ("x" plus (nil.std.text::from_byte with code being 27) plus "[31mred")),
        expected being "x [31mred"

    !!! A malformed request has no request line to log, and logging the raw
    !!! bytes would put attacker text into the file.
    evaluate record-malformed with client being "127.0.0.1:1", code being 400, at-ms being 784111777000
    evaluate flush-now with nothing
    value after-bad is nil.std.io::read_text with path being log-file
    consider after-bad
        when Result.Ok holding body then
            evaluate is-true with label being "a malformed request logs a dash, not its bytes",
                actual being (nil.std.text::contains with s being body, needle being quote plus "-" plus quote plus " 400 0")
        otherwise evaluate is-true with label being "the malformed line was written", actual being false
    end consider

    !!! The error log sorts in time order because the instant comes first.
    evaluate record-error with severity being "warn", message being "a port was taken", at-ms being 784111777000
    evaluate flush-now with nothing
    value errors is nil.std.io::read_text with path being err-file
    consider errors
        when Result.Ok holding body then
            evaluate same-text with label being "an error line leads with an ISO instant",
                actual being (nil.std.text::trim with s being body),
                expected being "1994-11-06T08:49:37Z [warn] a port was taken"
        otherwise evaluate is-true with label being "the error log was written", actual being false
    end consider

    !!! A log that cannot be written must not turn every request into a second
    !!! failure, and must not grow the buffer until the process runs out of
    !!! memory. The lines are dropped and counted.
    value before-drops is dropped-count with nothing
    evaluate log-to with access-file being "tests/no-such-directory/access.log", error-file being ""
    evaluate record-request with client being "192.0.2.10:40002", request being logged, code being 200, bytes being 1, at-ms being 784111777000
    evaluate flush-now with nothing
    evaluate same-number with label being "an unwritable log holds nothing",
        actual being (buffered-count with nothing), expected being 0
    evaluate is-true with label being "an unwritable log counts what it dropped",
        actual being (dropped-count with nothing) is greater than before-drops

    evaluate log-to with access-file being "", error-file being ""
    evaluate nil.std.io::delete with path being log-file
    evaluate nil.std.io::delete with path being err-file
    give nothing
end paragraph


!!! The log module keeps `shown` private; this is the same rule, for the test.
shown-for receives raw as text returns text begin paragraph
    value cleaned is one-line with raw being raw
    give when cleaned equals "" give "-" otherwise give cleaned end when
end paragraph

config-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.config.settings"
    value fallback-settings is default-settings with nothing
    evaluate same-text with label being "the default host is loopback", actual being fallback-settings.host, expected being "127.0.0.1"
    evaluate same-number with label being "the default port is 8080", actual being fallback-settings.port, expected being 8080
    evaluate is-true with label being "logging is off by default", actual being fallback-settings.access-log equals ""
    evaluate same-number with label being "there is one default site", actual being the length of fallback-settings.sites, expected being 1

    !!! Not naming a file and naming one that is absent are the same
    !!! intention, and neither is a failure.
    evaluate is-true with label being "no config file is not a failure",
        actual being (load-settings with path being "").loaded
    evaluate is-true with label being "an absent config file is not a failure",
        actual being (load-settings with path being "tests/no-such.nildata").loaded
    evaluate same-number with label being "an absent file keeps the default port",
        actual being (load-settings with path being "tests/no-such.nildata").port, expected being 8080

    value held is load-settings with path being "tests/sample.nildata"
    evaluate is-true with label being "a config file loads", actual being held.loaded
    evaluate same-text with label being "the host is read", actual being held.host, expected being "0.0.0.0"
    evaluate same-number with label being "the port is read", actual being held.port, expected being 9443
    evaluate same-number with label being "the connection limit is read", actual being held.connection-limit, expected being 4096
    evaluate same-text with label being "the access log path is read", actual being held.access-log, expected being "logs/access.log"
    evaluate same-text with label being "the error log path is read", actual being held.error-log, expected being "logs/error.log"
    evaluate is-true with label being "a boolean is read", actual being held.share-port
    evaluate is-true with label being "a second boolean is read", actual being held.reload-templates
    evaluate same-number with label being "every site is read", actual being the length of held.sites, expected being 3

    !!! Virtual hosts.
    value first-site is site-for with held-settings being held, host-header being "example.com"
    evaluate same-text with label being "a site is matched by Host", actual being first-site.template-root, expected being "sites/example"
    evaluate same-text with label being "its public root is read", actual being first-site.public-root, expected being "sites/example/static"
    evaluate same-text with label being "its index page is read", actual being first-site.index-page, expected being "index.nilhtml"
    evaluate same-text with label being "a Host match folds case",
        actual being (site-for with held-settings being held, host-header being "EXAMPLE.com").template-root,
        expected being "sites/example"
    evaluate same-text with label being "a port on the Host is ignored",
        actual being (site-for with held-settings being held, host-header being "example.com:8080").template-root,
        expected being "sites/example"
    evaluate same-text with label being "a second site is matched",
        actual being (site-for with held-settings being held, host-header being "other.test").template-root,
        expected being "sites/other"
    evaluate same-text with label being "a site with no publicRoot derives one",
        actual being (site-for with held-settings being held, host-header being "other.test").public-root,
        expected being "sites/other/public"
    evaluate same-text with label being "an unknown Host falls back to the default site",
        actual being (site-for with held-settings being held, host-header being "nobody.invalid").template-root,
        expected being "sites/fallback"
    evaluate same-text with label being "an empty Host falls back to the default site",
        actual being (site-for with held-settings being held, host-header being "").template-root,
        expected being "sites/fallback"
    evaluate is-true with label being "a wildcard is not matched as one",
        actual being not ((site-for with held-settings being held,
            host-header being "anything.example.com").template-root equals "sites/example")

    !!! Host parsing, including the IPv6 literal that a naive split breaks on.
    evaluate same-text with label being "a bare host is itself",
        actual being (host-only with header being "example.com"), expected being "example.com"
    evaluate same-text with label being "a port is stripped",
        actual being (host-only with header being "example.com:8080"), expected being "example.com"
    evaluate same-text with label being "an IPv6 literal keeps its brackets and colons",
        actual being (host-only with header being "[2001:db8::1]:8080"), expected being "[2001:db8::1]"
    evaluate same-text with label being "an IPv6 literal with no port survives",
        actual being (host-only with header being "[::1]"), expected being "[::1]"
    evaluate same-text with label being "a host is folded",
        actual being (host-only with header being "Example.COM"), expected being "example.com"

    !!! A site list with no default refuses an unknown Host rather than
    !!! serving another tenant's files.
    value only-named is settings-from with source being
        begin text
        nildata 1
        object
          schema is "nil.web.v1"
          sites is an array
            item is an object
              host is "one.test"
              templateRoot is "one"
            end object
          end array
        end object
        end text
    evaluate is-true with label being "a named site is found", actual being (has-site with held-settings being only-named, host-header being "one.test")
    evaluate is-true with label being "an unknown Host with no default site is refused",
        actual being not (has-site with held-settings being only-named, host-header being "two.test")

    !!! A file somebody wrote and meant something by, that will not parse, is
    !!! a failure. An unknown schema is refused rather than read hopefully.
    value broken is load-settings with path being "tests/broken.nildata"
    evaluate is-true with label being "a malformed config file is a failure", actual being not broken.loaded
    evaluate is-true with label being "a malformed config file says why", actual being not (broken.complaint equals "")
    evaluate same-number with label being "a malformed config still yields usable defaults", actual being broken.port, expected being 8080
    value wrong-schema is load-settings with path being "tests/bad-schema.nildata"
    evaluate is-true with label being "an unknown schema is refused", actual being not wrong-schema.loaded
    evaluate is-true with label being "an unknown schema does not take the file's port",
        actual being not (wrong-schema.port equals 1)

    !!! An empty sites array is the same as none at all.
    value no-sites is settings-from with source being
        begin text
        nildata 1
        object
          schema is "nil.web.v1"
          sites is an array
          end array
        end object
        end text
    evaluate same-number with label being "an empty site list keeps the default site",
        actual being the length of no-sites.sites, expected being 1
    give nothing
end paragraph

main returns number begin paragraph
    say "nilweb tests"
    evaluate scan-tests with nothing
    evaluate method-tests with nothing
    evaluate status-tests with nothing
    evaluate header-tests with nothing
    evaluate uri-tests with nothing
    evaluate request-tests with nothing
    evaluate response-tests with nothing
    evaluate router-tests with nothing
    evaluate template-tests with nothing
    evaluate session-tests with nothing
    evaluate static-tests with nothing
    evaluate run-sha256-tests with nothing
    evaluate run-static-http-tests with nothing
    evaluate middleware-tests with nothing
    evaluate listener-tests with nothing
    evaluate clock-tests with nothing
    evaluate log-tests with nothing
    evaluate config-tests with nothing
    give verdict with nothing
end paragraph
