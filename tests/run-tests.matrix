!!! The test entry point: every suite runs from here and the exit code is the
!!! verdict, so `nilinterpreter tests.nil` is the whole check.

book nilweb.tests.run

read everything from nilweb.tests.harness
read everything from nilweb.tests.sha256
read everything from nilweb.tests.static_http
read nil.std.core
read nil.std.text
read everything from nilweb.text.scan
read everything from nilweb.http.method
read everything from nilweb.http.status
read everything from nilweb.http.headers
read everything from nilweb.http.uri
read everything from nilweb.http.request
read everything from nilweb.http.response
read everything from nilweb.routing.router
read everything from nilweb.template.context
read everything from nilweb.template.render
read everything from nilweb.session.session
read everything from nilweb.static.files
read everything from nilweb.middleware.chain
read everything from nilweb.server.engine
read everything from nilweb.time.clock
read everything from nilweb.log.access
read everything from nilweb.config.settings

scan-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.text.scan"
    value parts is split-on with input being "a/b/c", separator being "/"
    evaluate same-number with label being "split-on counts the parts", actual being the length of parts, expected being 3
    evaluate same-text with label being "split-on keeps the first", actual being parts at 0, expected being "a"
    evaluate same-text with label being "split-on keeps the last", actual being parts at 2, expected being "c"

    value edges is split-on with input being "/a/", separator being "/"
    evaluate same-number with label being "a leading and trailing separator make empty parts", actual being the length of edges, expected being 3
    evaluate same-text with label being "the part before a leading separator is empty", actual being edges at 0, expected being ""
    evaluate same-text with label being "the part after a trailing separator is empty", actual being edges at 2, expected being ""

    value whole is split-on with input being "nothing to cut", separator being "|"
    evaluate same-number with label being "no separator gives one part", actual being the length of whole, expected being 1

    evaluate same-text with label being "before-first cuts at the separator",
        actual being (before-first with input being "name=value", separator being "="), expected being "name"
    evaluate same-text with label being "after-first takes the remainder",
        actual being (after-first with input being "name=value", separator being "="), expected being "value"
    evaluate same-text with label being "after-first on a missing separator is empty",
        actual being (after-first with input being "novalue", separator being "="), expected being ""
    evaluate same-text with label being "after-first keeps later separators",
        actual being (after-first with input being "a=b=c", separator being "="), expected being "b=c"

    evaluate is-true with label being "field names fold case",
        actual being (same-folded with left being "Content-Type", right being "content-type")
    evaluate is-true with label being "different names do not fold together",
        actual being not (same-folded with left being "Accept", right being "Accept-Encoding")
    evaluate is-true with label being "whitespace is blank", actual being (nilweb.text.scan::is-blank with input being "   ")
    give nothing
end paragraph

method-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.http.method"
    evaluate same-text with label being "GET round-trips",
        actual being (method-name with verb being (parse-method with word being "GET")), expected being "GET"
    evaluate same-text with label being "DELETE round-trips",
        actual being (method-name with verb being (parse-method with word being "DELETE")), expected being "DELETE"
    evaluate is-true with label being "a known method is recognised", actual being (is-known-method with word being "PATCH")
    evaluate is-true with label being "lower case is not a method", actual being not (is-known-method with word being "get")
    evaluate is-true with label being "nonsense is not a method", actual being not (is-known-method with word being "BREW")
    evaluate is-true with label being "HEAD suppresses the body",
        actual being (body-is-suppressed with verb being request-method.Head)
    evaluate is-true with label being "GET does not suppress the body",
        actual being not (body-is-suppressed with verb being request-method.Get)
    give nothing
end paragraph

status-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.http.status"
    evaluate same-text with label being "a known code has its registered phrase",
        actual being (reason-phrase with code being 404), expected being "Not Found"
    evaluate same-text with label being "an unregistered 4xx still names its class",
        actual being (reason-phrase with code being 418), expected being "Client Error"
    evaluate same-text with label being "an unregistered 5xx still names its class",
        actual being (reason-phrase with code being 599), expected being "Server Error"
    evaluate same-text with label being "status-digits writes three digits", actual being (status-digits with code being 200), expected being "200"
    evaluate same-text with label being "status-digits keeps a leading digit of 1", actual being (status-digits with code being 100), expected being "100"
    evaluate same-text with label being "status-digits handles a middle zero", actual being (status-digits with code being 503), expected being "503"
    evaluate same-text with label being "an impossible code renders as 500", actual being (status-digits with code being 42), expected being "500"
    evaluate is-true with label being "204 forbids a body", actual being (status-forbids-body with code being 204)
    evaluate is-true with label being "304 forbids a body", actual being (status-forbids-body with code being 304)
    evaluate is-true with label being "200 permits a body", actual being not (status-forbids-body with code being 200)
    evaluate is-true with label being "303 is a redirect", actual being (is-redirect with code being 303)
    evaluate is-true with label being "404 is an error", actual being (is-error with code being 404)
    evaluate is-true with label being "299 is not an error", actual being not (is-error with code being 299)
    give nothing
end paragraph

header-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.http.headers"
    variable fields is no-headers with nothing
    set fields to set-field with fields being fields, name being "Content-Type", content being "text/html"
    set fields to set-field with fields being fields, name being "Host", content being "localhost:8080"
    evaluate same-number with label being "two fields set means two fields", actual being the length of fields, expected being 2
    evaluate same-text with label being "a field reads back",
        actual being (field-value with fields being fields, name being "Host"), expected being "localhost:8080"
    evaluate same-text with label being "lookup folds case",
        actual being (field-value with fields being fields, name being "CONTENT-TYPE"), expected being "text/html"
    evaluate same-text with label being "an absent field reads as empty",
        actual being (field-value with fields being fields, name being "Accept"), expected being ""
    evaluate is-true with label being "has-field tells absent from empty",
        actual being not (has-field with fields being fields, name being "Accept")

    set fields to set-field with fields being fields, name being "content-type", content being "application/json"
    evaluate same-number with label being "set-field replaces rather than repeats", actual being the length of fields, expected being 2
    evaluate same-text with label being "set-field replaced the value",
        actual being (field-value with fields being fields, name being "Content-Type"), expected being "application/json"

    set fields to add-field with fields being fields, name being "Set-Cookie", content being "a=1"
    set fields to add-field with fields being fields, name being "Set-Cookie", content being "b=2"
    evaluate same-number with label being "add-field keeps repeats", actual being the length of fields, expected being 4
    value cookies is field-values with fields being fields, name being "Set-Cookie"
    evaluate same-number with label being "both cookies come back", actual being the length of cookies, expected being 2
    evaluate same-text with label being "repeats keep their order", actual being cookies at 0, expected being "a=1"

    set fields to remove-field with fields being fields, name being "set-cookie"
    evaluate same-number with label being "remove-field drops every repeat", actual being the length of fields, expected being 2

    value parsed is parse-field with line being "Accept-Encoding:  gzip, deflate  "
    evaluate same-text with label being "a header line parses its name", actual being parsed.name, expected being "Accept-Encoding"
    evaluate same-text with label being "a header line trims its value", actual being parsed.content, expected being "gzip, deflate"
    value colon-in-value is parse-field with line being "Host: localhost:8080"
    evaluate same-text with label being "only the first colon separates", actual being colon-in-value.content, expected being "localhost:8080"
    value malformed is parse-field with line being "no colon here"
    evaluate same-text with label being "a line with no colon yields no name", actual being malformed.name, expected being ""
    evaluate same-number with label being "a CRLF is two characters",
        actual being (nil.std.text::length with s being (crlf with nothing)), expected being 2
    give nothing
end paragraph

uri-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.http.uri"
    evaluate same-text with label being "a plus decodes to a space",
        actual being (decode-component with raw being "hello+world"), expected being "hello world"
    evaluate same-text with label being "an escape decodes to its byte",
        actual being (decode-component with raw being "a%20b"), expected being "a b"
    evaluate same-text with label being "two escapes decode to one character",
        actual being (decode-component with raw being "caf%C3%A9"), expected being (nil.std.core::Convert.i32_to_char with code being 99) plus "af" plus (nil.std.core::Convert.i32_to_char with code being 233)
    evaluate same-number with label being "a decoded character is its UTF-8 width, not two characters",
        actual being (nil.std.text::length with s being (decode-component with raw being "caf%C3%A9")), expected being 5
    evaluate same-number with label being "a three-byte escape decodes to one character",
        actual being (nil.std.text::length with s being (decode-component with raw being "%E2%82%AC")), expected being 3
    evaluate same-text with label being "a three-byte escape is the right character",
        actual being (decode-component with raw being "%E2%82%AC"), expected being (nil.std.core::Convert.i32_to_char with code being 8364)
    evaluate same-text with label being "a four-byte escape decodes past the first plane",
        actual being (decode-component with raw being "%F0%9F%92%A1"), expected being (nil.std.core::Convert.i32_to_char with code being 128161)
    evaluate same-text with label being "escaped text sits correctly between literal text",
        actual being (decode-component with raw being "a%C3%A9b"), expected being "a" plus (nil.std.core::Convert.i32_to_char with code being 233) plus "b"
    evaluate same-text with label being "a truncated sequence becomes the replacement character",
        actual being (decode-component with raw being "%C3"), expected being (nil.std.core::Convert.i32_to_char with code being 65533)
    evaluate same-text with label being "a lone continuation byte becomes the replacement character",
        actual being (decode-component with raw being "%A9"), expected being (nil.std.core::Convert.i32_to_char with code being 65533)
    evaluate same-text with label being "an overlong encoding is rejected",
        actual being (decode-component with raw being "%C0%AF"), expected being (nil.std.core::Convert.i32_to_char with code being 65533) plus (nil.std.core::Convert.i32_to_char with code being 65533)
    evaluate same-text with label being "a surrogate half is rejected",
        actual being (decode-component with raw being "%ED%A0%80"), expected being (nil.std.core::Convert.i32_to_char with code being 65533) plus (nil.std.core::Convert.i32_to_char with code being 65533) plus (nil.std.core::Convert.i32_to_char with code being 65533)
    evaluate same-text with label being "a non-ASCII character encodes as its UTF-8 bytes",
        actual being (encode-component with raw being (nil.std.core::Convert.i32_to_char with code being 233)), expected being "%C3%A9"
    evaluate same-text with label being "a three-byte character encodes as three escapes",
        actual being (encode-component with raw being (nil.std.core::Convert.i32_to_char with code being 8364)), expected being "%E2%82%AC"
    evaluate same-text with label being "a four-byte character encodes as four escapes",
        actual being (encode-component with raw being (nil.std.core::Convert.i32_to_char with code being 128161)), expected being "%F0%9F%92%A1"
    evaluate same-text with label being "non-ASCII round-trips through encode and decode",
        actual being (decode-component with raw being (encode-component with raw being
            "caf" plus (nil.std.core::Convert.i32_to_char with code being 233))),
        expected being "caf" plus (nil.std.core::Convert.i32_to_char with code being 233)
    evaluate same-text with label being "a mixed name encodes only what must be escaped",
        actual being (encode-component with raw being "Ada Lovelace"), expected being "Ada%20Lovelace"
    evaluate same-text with label being "lower case hex decodes too",
        actual being (decode-component with raw being "a%2fb"), expected being "a/b"
    evaluate same-text with label being "a stray percent is kept, not dropped",
        actual being (decode-component with raw being "100%"), expected being "100%"
    evaluate same-text with label being "a percent with bad hex is kept",
        actual being (decode-component with raw being "a%zzb"), expected being "a%zzb"

    evaluate same-text with label being "unreserved characters pass through encoding",
        actual being (encode-component with raw being "aZ0-._~"), expected being "aZ0-._~"
    evaluate same-text with label being "a space encodes as %20, never a plus",
        actual being (encode-component with raw being "a b"), expected being "a%20b"
    evaluate same-text with label being "a separator encodes",
        actual being (encode-component with raw being "a/b&c=d"), expected being "a%2Fb%26c%3Dd"
    evaluate same-text with label being "encode and decode round-trip",
        actual being (decode-component with raw being (encode-component with raw being "a b/c&d=e?f")), expected being "a b/c&d=e?f"

    value parameters is parse-parameters with raw being "name=ada&role=engineer&tag=a&tag=b"
    evaluate same-number with label being "every pair is parsed", actual being the length of parameters, expected being 4
    evaluate same-text with label being "a parameter reads back",
        actual being (parameter-value with parameters being parameters, name being "role"), expected being "engineer"
    evaluate same-number with label being "a repeated name keeps both values",
        actual being the length of (parameter-values with parameters being parameters, name being "tag"), expected being 2
    evaluate same-text with label being "an absent parameter is empty",
        actual being (parameter-value with parameters being parameters, name being "missing"), expected being ""
    evaluate is-true with label being "has-parameter tells absent from empty",
        actual being not (has-parameter with parameters being parameters, name being "missing")

    value bare is parse-parameters with raw being "debug"
    evaluate same-number with label being "a bare key is one parameter", actual being the length of bare, expected being 1
    evaluate is-true with label being "a bare key is present", actual being (has-parameter with parameters being bare, name being "debug")
    evaluate same-text with label being "a bare key has an empty value", actual being (parameter-value with parameters being bare, name being "debug"), expected being ""

    value gappy is parse-parameters with raw being "a=1&&b=2"
    evaluate same-number with label being "an empty segment is skipped", actual being the length of gappy, expected being 2
    evaluate same-number with label being "an empty query has no parameters",
        actual being the length of (parse-parameters with raw being ""), expected being 0

    value encoded is parse-parameters with raw being "q=a%26b&name=ada+lovelace"
    evaluate same-text with label being "a separator inside a value survives the split",
        actual being (parameter-value with parameters being encoded, name being "q"), expected being "a&b"
    evaluate same-text with label being "a form plus decodes inside a value",
        actual being (parameter-value with parameters being encoded, name being "name"), expected being "ada lovelace"

    evaluate same-text with label being "a target splits off its path",
        actual being (target-path with target being "/users/42?tab=posts"), expected being "/users/42"
    evaluate same-text with label being "a target splits off its query",
        actual being (target-query with target being "/users/42?tab=posts"), expected being "tab=posts"
    evaluate same-text with label being "a target with no query has an empty query",
        actual being (target-query with target being "/users/42"), expected being ""
    evaluate same-text with label being "a path is percent-decoded",
        actual being (target-path with target being "/files/my%20report.txt"), expected being "/files/my report.txt"
    give nothing
end paragraph

request-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.http.request"
    value wire is "GET /users/42?tab=posts HTTP/1.1" plus (crlf with nothing)
        plus "Host: localhost:8080" plus (crlf with nothing)
        plus "Accept: text/html" plus (crlf with nothing)
        plus "Cookie: session=abc123; theme=dark" plus (crlf with nothing)
        plus (crlf with nothing)
    value parsed is parse-request with raw being wire
    evaluate is-true with label being "a well-formed request parses", actual being parsed.well-formed
    evaluate same-text with label being "the method is read", actual being (method-name with verb being parsed.verb), expected being "GET"
    evaluate same-text with label being "the path is split from the query", actual being parsed.path, expected being "/users/42"
    evaluate same-text with label being "the query is kept", actual being parsed.query-text, expected being "tab=posts"
    evaluate same-text with label being "the version is read", actual being parsed.version, expected being "HTTP/1.1"
    evaluate same-number with label being "every header is kept", actual being the length of parsed.fields, expected being 3
    evaluate same-text with label being "a header reads back",
        actual being (header-of with request being parsed, name being "accept"), expected being "text/html"
    evaluate same-text with label being "the host reads back", actual being (host-of with request being parsed), expected being "localhost:8080"
    evaluate same-text with label being "a query parameter reads back",
        actual being (query-of with request being parsed, name being "tab"), expected being "posts"
    evaluate same-text with label being "a cookie reads back",
        actual being (cookie-of with request being parsed, name being "session"), expected being "abc123"
    evaluate same-text with label being "a later cookie reads back",
        actual being (cookie-of with request being parsed, name being "theme"), expected being "dark"
    evaluate same-text with label being "an absent cookie is empty",
        actual being (cookie-of with request being parsed, name being "missing"), expected being ""
    evaluate same-number with label being "a request with no body has none", actual being (body-length with request being parsed), expected being 0

    value posted is parse-request with raw being ("POST /login HTTP/1.1" plus (crlf with nothing)
        plus "Host: example.com" plus (crlf with nothing)
        plus "Content-Type: application/x-www-form-urlencoded; charset=utf-8" plus (crlf with nothing)
        plus (crlf with nothing)
        plus "name=ada+lovelace&password=a%26b")
    evaluate same-text with label being "a POST reads its method", actual being (method-name with verb being posted.verb), expected being "POST"
    evaluate same-text with label being "the body survives the header split", actual being posted.body, expected being "name=ada+lovelace&password=a%26b"
    evaluate same-text with label being "the media type drops its parameters",
        actual being (content-kind with request being posted), expected being "application/x-www-form-urlencoded"
    evaluate is-true with label being "a urlencoded body is recognised", actual being (is-form-encoded with request being posted)
    evaluate same-text with label being "a form field decodes",
        actual being (form-of with request being posted, name being "name"), expected being "ada lovelace"
    evaluate same-text with label being "a form field decodes its escapes",
        actual being (form-of with request being posted, name being "password"), expected being "a&b"

    value loose is parse-request with raw being ("GET / HTTP/1.1" plus newline plus "Host: x" plus newline plus newline plus "body")
    evaluate is-true with label being "bare LF is tolerated", actual being loose.well-formed
    evaluate same-text with label being "a bare-LF body is found", actual being loose.body, expected being "body"

    value empty is parse-request with raw being ""
    evaluate is-true with label being "an empty request is not well formed", actual being not empty.well-formed
    value short-line is parse-request with raw being ("GET" plus (crlf with nothing) plus (crlf with nothing))
    evaluate is-true with label being "a short request line is not well formed", actual being not short-line.well-formed
    value odd-verb is parse-request with raw being ("BREW /pot HTTP/1.1" plus (crlf with nothing) plus (crlf with nothing))
    evaluate is-true with label being "an unknown method is not well formed", actual being not odd-verb.well-formed
    evaluate is-true with label being "a malformed request says why", actual being not (odd-verb.complaint equals "")
    give nothing
end paragraph

response-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.http.response"
    value page is html-response with body being "<h1>hi</h1>"
    evaluate same-number with label being "an html response is 200", actual being page.code, expected being 200
    evaluate same-text with label being "an html response says so",
        actual being (field-value with fields being page.fields, name being "Content-Type"), expected being "text/html; charset=utf-8"

    value rendered is render-for-get with response being page
    evaluate is-true with label being "the status line comes first",
        actual being (nil.std.text::starts_with with s being rendered, prefix being "HTTP/1.1 200 OK")
    evaluate is-true with label being "Content-Length is set from the body",
        actual being (nil.std.text::contains with s being rendered, needle being "Content-Length: 11")
    evaluate is-true with label being "a blank line separates the body",
        actual being (nil.std.text::contains with s being rendered, needle being (crlf with nothing) plus (crlf with nothing) plus "<h1>hi</h1>")

    value multibyte is render-for-get with response being (text-response with body being "caf" plus (nil.std.core::Convert.i32_to_char with code being 233))
    evaluate is-true with label being "Content-Length counts bytes, not characters",
        actual being (nil.std.text::contains with s being multibyte, needle being "Content-Length: 5")

    value head-rendered is render-response with response being page, verb being request-method.Head
    evaluate is-true with label being "a HEAD keeps its Content-Length",
        actual being (nil.std.text::contains with s being head-rendered, needle being "Content-Length: 11")
    evaluate is-true with label being "a HEAD sends no body",
        actual being not (nil.std.text::contains with s being head-rendered, needle being "<h1>hi</h1>")

    value nothing-sent is render-for-get with response being (empty-response with code being 204)
    evaluate is-true with label being "a 204 has no Content-Length at all",
        actual being not (nil.std.text::contains with s being nothing-sent, needle being "Content-Length")

    value moved is redirect-response with location being "/after"
    evaluate same-number with label being "a redirect is 303 by default", actual being moved.code, expected being 303
    evaluate same-text with label being "a redirect sets Location",
        actual being (field-value with fields being moved.fields, name being "Location"), expected being "/after"

    value missing is not-found-response with path being "/nope"
    evaluate same-number with label being "a not-found is 404", actual being missing.code, expected being 404
    evaluate is-true with label being "a not-found names the path",
        actual being (nil.std.text::contains with s being missing.body, needle being "/nope")

    value refused is method-not-allowed-response with allowed being "GET, HEAD"
    evaluate same-number with label being "a refusal is 405", actual being refused.code, expected being 405
    evaluate same-text with label being "a refusal says what is allowed",
        actual being (field-value with fields being refused.fields, name being "Allow"), expected being "GET, HEAD"

    value with-two is with-cookie with response being (with-cookie with response being page, name being "a", content being "1", attributes being "HttpOnly"),
        name being "b", content being "2", attributes being ""
    evaluate same-number with label being "two cookies are two fields",
        actual being the length of (field-values with fields being with-two.fields, name being "Set-Cookie"), expected being 2
    evaluate same-text with label being "a cookie carries its attributes",
        actual being (field-value with fields being with-two.fields, name being "Set-Cookie"), expected being "a=1; HttpOnly"

    evaluate same-text with label being "count-text writes a plain number", actual being (count-text with amount being 0), expected being "0"
    evaluate same-text with label being "count-text writes a long number", actual being (count-text with amount being 1048576), expected being "1048576"
    give nothing
end paragraph

router-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.routing.router"
    variable routes is no-routes with nothing
    set routes to get-route with routes being routes, pattern being "/", handler being "home"
    set routes to get-route with routes being routes, pattern being "/users", handler being "user-index"
    set routes to get-route with routes being routes, pattern being "/users/new", handler being "user-new"
    set routes to get-route with routes being routes, pattern being "/users/:id", handler being "user-show"
    set routes to get-route with routes being routes, pattern being "/users/:id/posts/:slug", handler being "user-post"
    set routes to post-route with routes being routes, pattern being "/users", handler being "user-create"
    set routes to get-route with routes being routes, pattern being "/static/*rest", handler being "static"

    value root is match-route with routes being routes, verb being request-method.Get, path being "/"
    evaluate is-true with label being "the root path matches", actual being root.matched
    evaluate same-text with label being "the root route names its handler", actual being root.handler, expected being "home"

    value listing is match-route with routes being routes, verb being request-method.Get, path being "/users"
    evaluate same-text with label being "a literal route matches", actual being listing.handler, expected being "user-index"

    value literal-first is match-route with routes being routes, verb being request-method.Get, path being "/users/new"
    evaluate same-text with label being "declaration order puts the literal before the capture",
        actual being literal-first.handler, expected being "user-new"

    value one-user is match-route with routes being routes, verb being request-method.Get, path being "/users/42"
    evaluate same-text with label being "a capture route matches", actual being one-user.handler, expected being "user-show"
    evaluate same-text with label being "a capture reads back by name",
        actual being (capture-of with result being one-user, name being "id"), expected being "42"

    value nested is match-route with routes being routes, verb being request-method.Get, path being "/users/42/posts/hello-world"
    evaluate same-text with label being "two captures both match", actual being nested.handler, expected being "user-post"
    evaluate same-text with label being "the first capture is right",
        actual being (capture-of with result being nested, name being "id"), expected being "42"
    evaluate same-text with label being "the second capture is right",
        actual being (capture-of with result being nested, name being "slug"), expected being "hello-world"

    value posted is match-route with routes being routes, verb being request-method.Post, path being "/users"
    evaluate same-text with label being "the method selects between two routes on one path",
        actual being posted.handler, expected being "user-create"

    value as-head is match-route with routes being routes, verb being request-method.Head, path being "/users"
    evaluate same-text with label being "a HEAD is served by the GET route", actual being as-head.handler, expected being "user-index"

    value deep is match-route with routes being routes, verb being request-method.Get, path being "/static/css/app.css"
    evaluate same-text with label being "a wildcard matches the rest of the path", actual being deep.handler, expected being "static"
    evaluate same-text with label being "a wildcard captures the separators too",
        actual being (capture-of with result being deep, name being "rest"), expected being "css/app.css"

    value missing is match-route with routes being routes, verb being request-method.Get, path being "/nothing-here"
    evaluate is-true with label being "an unclaimed path does not match", actual being not missing.matched
    evaluate is-true with label being "an unclaimed path is a 404, not a 405", actual being not missing.path-matched

    value wrong-method is match-route with routes being routes, verb being request-method.Delete, path being "/users"
    evaluate is-true with label being "a wrong method does not match", actual being not wrong-method.matched
    evaluate is-true with label being "a claimed path with a wrong method is a 405", actual being wrong-method.path-matched
    evaluate same-text with label being "the 405 says what is allowed",
        actual being wrong-method.allowed, expected being "GET, HEAD, POST"

    evaluate is-true with label being "a capture does not match an empty segment",
        actual being not (match-pattern with pattern being "/users/:id", path being "/users/").matched
    evaluate is-true with label being "a short path does not match a long pattern",
        actual being not (match-pattern with pattern being "/a/b/c", path being "/a/b").matched
    evaluate is-true with label being "a long path does not match a short pattern",
        actual being not (match-pattern with pattern being "/a/b", path being "/a/b/c").matched
    evaluate is-true with label being "a trailing separator is ignored",
        actual being (match-pattern with pattern being "/users", path being "/users/").matched
    evaluate is-true with label being "a wildcard needs something to take",
        actual being not (match-pattern with pattern being "/static/*rest", path being "/static/").matched
    give nothing
end paragraph

template-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.template"
    variable page-data is empty-context with nothing
    set page-data to with-value with page-data being page-data, name being "name", content being "Ada"
    set page-data to with-value with page-data being page-data, name being "bio", content being "<script>alert(1)</script>"
    set page-data to with-flag with page-data being page-data, name being "member", held being true
    set page-data to with-flag with page-data being page-data, name being "banned", held being false

    evaluate same-text with label being "a value substitutes",
        actual being (rendered-text with source being "Hi <%= name %>!", page-data being page-data), expected being "Hi Ada!"
    evaluate same-text with label being "a value is HTML-escaped",
        actual being (rendered-text with source being "<%= bio %>", page-data being page-data),
        expected being "&lt;script&gt;alert(1)&lt;/script&gt;"
    evaluate same-text with label being "a raw value is not escaped",
        actual being (rendered-text with source being "<%! bio %>", page-data being page-data),
        expected being "<script>alert(1)</script>"
    evaluate same-text with label being "an unknown name renders as nothing",
        actual being (rendered-text with source being "[<%= nobody %>]", page-data being page-data), expected being "[]"
    evaluate same-text with label being "a comment is dropped",
        actual being (rendered-text with source being "a<%# note %>b", page-data being page-data), expected being "ab"

    evaluate same-text with label being "escaping does the ampersand first",
        actual being (escape-html with raw being "a&<b"), expected being "a&amp;&lt;b"
    evaluate same-text with label being "both quote styles are escaped",
        actual being (escape-html with raw being quote plus "'"), expected being "&quot;&#39;"

    evaluate same-text with label being "a set flag takes the if branch",
        actual being (rendered-text with source being "<% if member %>yes<% end %>", page-data being page-data), expected being "yes"
    evaluate same-text with label being "an unset flag skips the if branch",
        actual being (rendered-text with source being "<% if banned %>yes<% end %>", page-data being page-data), expected being ""
    evaluate same-text with label being "else is taken when the flag is unset",
        actual being (rendered-text with source being "<% if banned %>yes<% else %>no<% end %>", page-data being page-data), expected being "no"
    evaluate same-text with label being "else is skipped when the flag is set",
        actual being (rendered-text with source being "<% if member %>yes<% else %>no<% end %>", page-data being page-data), expected being "yes"
    evaluate same-text with label being "unless inverts the test",
        actual being (rendered-text with source being "<% unless banned %>clear<% end %>", page-data being page-data), expected being "clear"
    evaluate same-text with label being "nested blocks close in the right order",
        actual being (rendered-text with source being "<% if member %>[<% if banned %>x<% else %>y<% end %>]<% end %>", page-data being page-data),
        expected being "[y]"

    variable rows is no-rows with nothing
    set rows to add-row with rows being rows,
        one-row being (row-with with one-row being (row-with with one-row being (new-row with nothing),
            name being "title", content being "First"), name being "slug", content being "one")
    set rows to add-row with rows being rows,
        one-row being (row-with with one-row being (row-with with one-row being (new-row with nothing),
            name being "title", content being "Second"), name being "slug", content being "two")
    set page-data to with-rows with page-data being page-data, name being "posts", rows being rows

    evaluate same-text with label being "a loop repeats its body",
        actual being (rendered-text with source being "<% for post in posts %>[<%= post.title %>]<% end %>", page-data being page-data),
        expected being "[First][Second]"
    evaluate same-text with label being "a loop binds every cell",
        actual being (rendered-text with source being "<% for post in posts %><%= post.slug %><% end %>", page-data being page-data),
        expected being "onetwo"
    evaluate same-text with label being "a loop publishes its index",
        actual being (rendered-text with source being "<% for post in posts %><%= post.index %><% end %>", page-data being page-data),
        expected being "01"
    evaluate same-text with label being "a loop marks its first and last rows",
        actual being (rendered-text with source being "<% for post in posts %><% if post.first %>F<% end %><% if post.last %>L<% end %><% end %>", page-data being page-data),
        expected being "FL"
    evaluate same-text with label being "an empty set renders nothing",
        actual being (rendered-text with source being "<% for x in nothing-here %>no<% end %>", page-data being page-data), expected being ""
    evaluate same-text with label being "a conditional inside a loop works",
        actual being (rendered-text with source being "<% for post in posts %><% if post.first %><%= post.title %><% end %><% end %>", page-data being page-data),
        expected being "First"

    evaluate is-true with label being "an unclosed block is reported",
        actual being not (render-source with source being "<% if member %>oops", page-data being page-data, root being "").rendered
    evaluate is-true with label being "a stray end is reported",
        actual being not (render-source with source being "<% end %>", page-data being page-data, root being "").rendered
    evaluate is-true with label being "an unterminated tag is reported",
        actual being not (render-source with source being "<%= name", page-data being page-data, root being "").rendered
    evaluate is-true with label being "a malformed loop header is reported",
        actual being not (render-source with source being "<% for broken %>x<% end %>", page-data being page-data, root being "").rendered

    evaluate is-true with label being "a template name may not climb out of its directory",
        actual being not (load-template with name being "../outside-root.txt", root being "tests/templates").rendered
    evaluate is-true with label being "an absolute template name is refused",
        actual being not (load-template with name being "/etc/hostname", root being "tests/templates").rendered
    evaluate is-true with label being "a missing template is reported",
        actual being not (load-template with name being "no-such.nilhtml", root being "tests/templates").rendered

    variable page is empty-context with nothing
    set page to with-value with page-data being page, name being "title", content being "Welcome"
    set page to with-value with page-data being page, name being "heading", content being "Hello"
    set page to with-value with page-data being page, name being "site", content being "nil-web"
    value whole is render-file with name being "page.nilhtml", page-data being page, root being "tests/templates"
    evaluate is-true with label being "a page with a layout and an include renders", actual being whole.rendered
    evaluate is-true with label being "the layout wrapped the page",
        actual being (nil.std.text::starts_with with s being whole.text-out, prefix being "<!doctype html>")
    evaluate is-true with label being "the layout read its own value",
        actual being (nil.std.text::contains with s being whole.text-out, needle being "<title>Welcome</title>")
    evaluate is-true with label being "the include was rendered",
        actual being (nil.std.text::contains with s being whole.text-out, needle being "<nav>nil-web</nav>")
    evaluate is-true with label being "the page body is inside the layout",
        actual being (nil.std.text::contains with s being whole.text-out, needle being "<h1>Hello</h1>")

    evaluate is-true with label being "a template that includes itself is stopped",
        actual being not (render-file with name being "cycle.nilhtml", page-data being page, root being "tests/templates").rendered

    !!! The cache. A page that renders the same the second time is the whole
    !!! requirement; the rest is that it is actually being cached and that an
    !!! edited template is still noticed.
    evaluate clear-cache with nothing
    evaluate same-number with label being "the cache starts empty", actual being (cached-count with nothing), expected being 0
    value first-pass is render-file with name being "page.nilhtml", page-data being page, root being "tests/templates"
    evaluate is-true with label being "the first render succeeds", actual being first-pass.rendered
    evaluate same-number with label being "a page with a layout and an include caches three templates",
        actual being (cached-count with nothing), expected being 3
    value second-pass is render-file with name being "page.nilhtml", page-data being page, root being "tests/templates"
    evaluate same-text with label being "a cached render is identical to the first",
        actual being second-pass.text-out, expected being first-pass.text-out
    evaluate same-number with label being "rendering again caches nothing new",
        actual being (cached-count with nothing), expected being 3

    !!! Frozen, the cache is trusted without a timestamp check. The output
    !!! must not change, which is what says the frozen path renders from the
    !!! same tokens rather than a different route through the engine.
    evaluate freeze-cache with frozen being true
    value frozen-pass is render-file with name being "page.nilhtml", page-data being page, root being "tests/templates"
    evaluate same-text with label being "a frozen cache renders the same",
        actual being frozen-pass.text-out, expected being first-pass.text-out
    evaluate freeze-cache with frozen being false

    !!! A refused name is refused before it reaches the cache, so a traversal
    !!! attempt cannot plant an entry under a path outside the root.
    evaluate is-true with label being "a climbing name is refused by prepare",
        actual being not (prepare with name being "../outside-root.txt", root being "tests/templates").ready
    evaluate same-number with label being "a refused name caches nothing",
        actual being (cached-count with nothing), expected being 3

    !!! A layout may hold its own blocks. Rendering the layout token by token
    !!! around the slot was the first implementation and it broke exactly
    !!! this: an `if` spans several tokens, and one of them alone has no `end`.
    variable blocky is empty-context with nothing
    set blocky to with-value with page-data being blocky, name being "heading", content being "Body"
    set blocky to with-value with page-data being blocky, name being "who", content being "Ada"
    set blocky to with-flag with page-data being blocky, name being "signed-in", held being true
    variable trail is no-rows with nothing
    set trail to add-row with rows being trail,
        one-row being (row-with with one-row being (new-row with nothing), name being "name", content being "home")
    set trail to add-row with rows being trail,
        one-row being (row-with with one-row being (new-row with nothing), name being "name", content being "posts")
    set blocky to with-rows with page-data being blocky, name being "trail", rows being trail

    value wrapped is render-file with name being "blocky-page.nilhtml", page-data being blocky, root being "tests/templates"
    evaluate is-true with label being "a layout with its own blocks renders", actual being wrapped.rendered
    evaluate is-true with label being "a conditional in a layout takes its branch",
        actual being (nil.std.text::contains with s being wrapped.text-out, needle being "Hello Ada")
    evaluate is-true with label being "a conditional in a layout skips the other branch",
        actual being not (nil.std.text::contains with s being wrapped.text-out, needle being "Sign in")
    evaluate is-true with label being "the page lands inside the layout",
        actual being (nil.std.text::contains with s being wrapped.text-out, needle being "<p>Body</p>")
    evaluate is-true with label being "a loop after the slot renders",
        actual being (nil.std.text::contains with s being wrapped.text-out, needle being "[home][posts]")

    evaluate is-true with label being "a layout with no content slot is reported, not silently blank",
        actual being not (render-file with name being "slotless.nilhtml", page-data being blocky, root being "tests/templates").rendered
    give nothing
end paragraph


!!! --- Render and take the text, for the checks that expect success.

rendered-text receives source as text, page-data as render-context returns text begin paragraph
    value outcome is render-source with source being source, page-data being page-data, root being ""
    when not outcome.rendered then
        give "RENDER FAILED: " plus outcome.complaint
    end when
    give outcome.text-out
end paragraph

session-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.session"
    value start-time is 1000000
    variable store is new-store with nothing
    set store to store-with-lifetime with store being store, lifetime being 60000

    value drawn is new-session-id with nothing
    evaluate is-true with label being "a session id is available from the kernel", actual being drawn.available
    evaluate same-number with label being "a session id is sixteen bytes of hex",
        actual being (nil.std.text::length with s being drawn.id), expected being 32
    evaluate is-true with label being "two session ids differ",
        actual being not (drawn.id equals (new-session-id with nothing).id)
    value id is drawn.id
    set store to start-session with store being store, id being id, now-at being start-time
    evaluate is-true with label being "a started session is live",
        actual being (has-session with store being store, id being id, now-at being start-time)
    evaluate is-true with label being "an unknown id is not a session",
        actual being not (has-session with store being store, id being "other", now-at being start-time)

    set store to set-in with store being store, id being id, name being "user", content being "ada", now-at being start-time
    evaluate same-text with label being "a session value reads back",
        actual being (value-in with store being store, id being id, name being "user", now-at being start-time), expected being "ada"
    evaluate same-text with label being "an unset session value is empty",
        actual being (value-in with store being store, id being id, name being "role", now-at being start-time), expected being ""

    set store to set-in with store being store, id being id, name being "user", content being "grace", now-at being start-time
    evaluate same-text with label being "writing again replaces the value",
        actual being (value-in with store being store, id being id, name being "user", now-at being start-time), expected being "grace"
    evaluate same-number with label being "replacing does not duplicate the session",
        actual being (live-count with store being store, now-at being start-time), expected being 1

    value past-expiry is start-time plus 60001
    evaluate is-true with label being "a session past its lifetime is gone",
        actual being not (has-session with store being store, id being id, now-at being past-expiry)
    evaluate same-text with label being "an expired session reads as empty, not stale",
        actual being (value-in with store being store, id being id, name being "user", now-at being past-expiry), expected being ""

    value mid-life is start-time plus 30000
    set store to set-in with store being store, id being id, name being "user", content being "ada", now-at being mid-life
    evaluate is-true with label being "writing pushes the expiry out",
        actual being (has-session with store being store, id being id, now-at being past-expiry)

    set store to end-session with store being store, id being id
    evaluate is-true with label being "an ended session is gone",
        actual being not (has-session with store being store, id being id, now-at being mid-life)

    !!! A short lifetime, so the session started at time 1 is already past it
    !!! when the sweep runs. With the default hour both would still be live.
    variable second-store is store-with-lifetime with store being (new-store with nothing), lifetime being 1000
    value kept is (new-session-id with nothing).id
    value dropped is (new-session-id with nothing).id
    set second-store to start-session with store being second-store, id being kept, now-at being start-time
    set second-store to start-session with store being second-store, id being dropped, now-at being 1
    evaluate same-number with label being "sweeping drops only what expired",
        actual being (live-count with store being (sweep-expired with store being second-store, now-at being start-time),
            now-at being start-time), expected being 1

    value signed-in is with-session-cookie with response being (text-response with body being "in"),
        id being "abc", store being store, secure being true
    value crumb is field-value with fields being signed-in.fields, name being "Set-Cookie"
    evaluate is-true with label being "the session cookie is HttpOnly",
        actual being (nil.std.text::contains with s being crumb, needle being "HttpOnly")
    evaluate is-true with label being "the session cookie is SameSite=Lax",
        actual being (nil.std.text::contains with s being crumb, needle being "SameSite=Lax")
    evaluate is-true with label being "the session cookie is Secure when asked",
        actual being (nil.std.text::contains with s being crumb, needle being "Secure")
    evaluate is-true with label being "the session cookie is scoped to the application",
        actual being (nil.std.text::contains with s being crumb, needle being "Path=/")
    evaluate is-true with label being "the cookie lifetime matches the store",
        actual being (nil.std.text::contains with s being crumb, needle being "Max-Age=60")

    value plain-cookie is field-value with fields being (with-session-cookie with response being (text-response with body being "in"),
        id being "abc", store being store, secure being false).fields, name being "Set-Cookie"
    evaluate is-true with label being "Secure is left off when not asked",
        actual being not (nil.std.text::contains with s being plain-cookie, needle being "Secure")

    value signed-out is with-ended-cookie with response being (text-response with body being "out"), secure being true
    evaluate is-true with label being "signing out expires the cookie",
        actual being (nil.std.text::contains with s being
            (field-value with fields being signed-out.fields, name being "Set-Cookie"), needle being "Max-Age=0")

    value carrying is make-request with verb being request-method.Get, target being "/",
        fields being (set-field with fields being (no-headers with nothing), name being "Cookie",
            content being (cookie-name with nothing) plus "=xyz789"), body being ""
    evaluate same-text with label being "the session id is read off the request",
        actual being (session-id-of with request being carrying), expected being "xyz789"

    !!! begin-session is what a sign-in handler calls: a fresh id and a store
    !!! that holds it, or a refusal that must not be treated as a session.
    value opened-session is begin-session with store being (new-store with nothing), now-at being start-time
    evaluate is-true with label being "begin-session succeeds", actual being opened-session.available
    evaluate same-number with label being "begin-session draws a full-length id",
        actual being (nil.std.text::length with s being opened-session.id), expected being 32
    evaluate is-true with label being "begin-session put the session in the store",
        actual being (has-session with store being opened-session.store, id being opened-session.id, now-at being start-time)
    evaluate same-number with label being "begin-session created exactly one session",
        actual being (live-count with store being opened-session.store, now-at being start-time), expected being 1
    give nothing
end paragraph

static-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.static.files"
    value served is serve-file with root being "tests/public", path being "/assets/app.css"
    evaluate same-number with label being "a file under the root is served", actual being served.code, expected being 200
    evaluate same-text with label being "a stylesheet is typed as one",
        actual being (field-value with fields being served.fields, name being "Content-Type"), expected being "text/css; charset=utf-8"
    evaluate is-true with label being "the file content is the body",
        actual being (nil.std.text::contains with s being served.body, needle being "rebeccapurple")

    evaluate same-number with label being "climbing out of the root is a 404",
        actual being (serve-file with root being "tests/public", path being "/../outside-root.txt").code, expected being 404
    evaluate same-number with label being "a deeper climb is a 404",
        actual being (serve-file with root being "tests/public", path being "/assets/../../outside-root.txt").code, expected being 404
    evaluate same-number with label being "an absolute path is a 404",
        actual being (serve-file with root being "tests/public", path being "//etc/hostname").code, expected being 404
    evaluate same-number with label being "a dotfile is a 404 even though it exists",
        actual being (serve-file with root being "tests/public", path being "/.hidden").code, expected being 404
    evaluate is-true with label being "the name a probe actually asks for is refused by shape",
        actual being not (is-safe-name with name being ".env")
    evaluate is-true with label being "a nested environment file is refused by shape",
        actual being not (is-safe-name with name being "config/.env.production")
    evaluate same-number with label being "a missing file is a 404",
        actual being (serve-file with root being "tests/public", path being "/nope.css").code, expected being 404
    evaluate same-number with label being "the root itself is a 404",
        actual being (serve-file with root being "tests/public", path being "/").code, expected being 404

    evaluate is-true with label being "a backslash name is refused",
        actual being not (is-safe-name with name being "assets\\..\\outside-root.txt")
    evaluate is-true with label being "a drive-letter name is refused",
        actual being not (is-safe-name with name being "C:/windows/system32")
    evaluate is-true with label being "a doubled separator is refused",
        actual being not (is-safe-name with name being "assets//app.css")
    evaluate is-true with label being "a nested dotfile is refused",
        actual being not (is-safe-name with name being "assets/.git/config")
    evaluate is-true with label being "an ordinary name is allowed",
        actual being (is-safe-name with name being "assets/app.css")

    evaluate same-text with label being "an unknown extension is never HTML",
        actual being (media-type-of with name being "upload.weird"), expected being "application/octet-stream"
    evaluate same-text with label being "an extensionless name is never HTML",
        actual being (media-type-of with name being "LICENSE"), expected being "application/octet-stream"
    evaluate same-text with label being "a dot in a directory is not an extension",
        actual being (media-type-of with name being "v1.2/README"), expected being "application/octet-stream"
    evaluate same-text with label being "the extension folds case",
        actual being (media-type-of with name being "LOGO.PNG"), expected being "image/png"
    evaluate same-text with label being "javascript is typed",
        actual being (media-type-of with name being "app.js"), expected being "text/javascript; charset=utf-8"
    evaluate same-text with label being "a font is typed",
        actual being (media-type-of with name being "inter.woff2"), expected being "font/woff2"

    value cached is serve-cached with root being "tests/public", path being "/assets/app.css", seconds being 31536000
    evaluate same-text with label being "a cached asset says how long",
        actual being (field-value with fields being cached.fields, name being "Cache-Control"), expected being "public, max-age=31536000"
    evaluate is-true with label being "a 404 is never given a cache lifetime",
        actual being ((field-value with fields being (serve-cached with root being "tests/public",
            path being "/nope.css", seconds being 60).fields, name being "Cache-Control")) equals ""

    !!! Validators identify the bytes served.
    value marks is validators-of with root being "tests/public", path being "/assets/app.css"
    evaluate is-true with label being "a present file has validators", actual being marks.found
    evaluate same-number with label being "the width matches the file", actual being marks.width, expected being 31
    evaluate is-true with label being "the timestamp is a plausible epoch", actual being marks.stamped-at is greater than 1577836800000
    evaluate is-true with label being "the tag is quoted", actual being (nil.std.text::starts_with with s being marks.tag, prefix being quote)
    evaluate is-true with label being "an absent file has no validators",
        actual being not (validators-of with root being "tests/public", path being "/nope.css").found
    evaluate is-true with label being "a climbing name has no validators",
        actual being not (validators-of with root being "tests/public", path being "/../outside-root.txt").found

    !!! Revalidation. A client holding the current tag is told to keep it.
    value plain-get is make-request with verb being request-method.Get, target being "/assets/app.css",
        fields being (no-headers with nothing), body being ""
    value first-serve is serve-revalidated with root being "tests/public", path being "/assets/app.css",
        request being plain-get, seconds being 3600
    evaluate same-number with label being "a request with no validator gets the file", actual being first-serve.code, expected being 200
    evaluate same-text with label being "the response carries its tag",
        actual being (field-value with fields being first-serve.fields, name being "ETag"), expected being marks.tag

    value matching is make-request with verb being request-method.Get, target being "/assets/app.css",
        fields being (set-field with fields being (no-headers with nothing), name being "If-None-Match", content being marks.tag),
        body being ""
    value revalidated is serve-revalidated with root being "tests/public", path being "/assets/app.css",
        request being matching, seconds being 3600
    evaluate same-number with label being "a current copy is answered 304", actual being revalidated.code, expected being 304
    evaluate same-text with label being "a 304 sends no body", actual being revalidated.body, expected being ""
    evaluate is-true with label being "a 304 carries no Content-Length",
        actual being not (nil.std.text::contains with s being (render-for-get with response being revalidated), needle being "Content-Length")
    evaluate is-true with label being "a 304 carries no Content-Type",
        actual being not (has-field with fields being revalidated.fields, name being "Content-Type")

    value star is make-request with verb being request-method.Get, target being "/assets/app.css",
        fields being (set-field with fields being (no-headers with nothing), name being "If-None-Match", content being "*"),
        body being ""
    evaluate same-number with label being "a star validator matches anything present",
        actual being (serve-revalidated with root being "tests/public", path being "/assets/app.css",
            request being star, seconds being 60).code, expected being 304

    value stale is make-request with verb being request-method.Get, target being "/assets/app.css",
        fields being (set-field with fields being (no-headers with nothing), name being "If-None-Match",
            content being quote plus "something-else" plus quote),
        body being ""
    evaluate same-number with label being "a stale validator gets the file",
        actual being (serve-revalidated with root being "tests/public", path being "/assets/app.css",
            request being stale, seconds being 60).code, expected being 200

    value weak is make-request with verb being request-method.Get, target being "/assets/app.css",
        fields being (set-field with fields being (no-headers with nothing), name being "If-None-Match",
            content being "W/" plus marks.tag),
        body being ""
    evaluate same-number with label being "a weak prefix on a known tag still matches",
        actual being (serve-revalidated with root being "tests/public", path being "/assets/app.css",
            request being weak, seconds being 60).code, expected being 304

    !!! Ranges.
    evaluate is-true with label being "no Range header means no range asked",
        actual being not (range-of with stated being "", width being 100).present
    evaluate is-true with label being "an unknown unit is ignored, not refused",
        actual being not (range-of with stated being "items=0-10", width being 100).present
    value first-ten is range-of with stated being "bytes=0-9", width being 100
    evaluate same-number with label being "a range reads its first byte", actual being first-ten.first-byte, expected being 0
    evaluate same-number with label being "a range reads its last byte", actual being first-ten.last-byte, expected being 9
    value open-ended is range-of with stated being "bytes=90-", width being 100
    evaluate same-number with label being "an open-ended range runs to the end", actual being open-ended.last-byte, expected being 99
    value suffix is range-of with stated being "bytes=-10", width being 100
    evaluate same-number with label being "a suffix range starts from the end", actual being suffix.first-byte, expected being 90
    value over-long is range-of with stated being "bytes=-500", width being 100
    evaluate same-number with label being "a suffix longer than the file is the whole file",
        actual being over-long.first-byte, expected being 0
    value clipped is range-of with stated being "bytes=50-500", width being 100
    evaluate same-number with label being "a range past the end is clipped", actual being clipped.last-byte, expected being 99
    evaluate is-true with label being "a first byte past the end is unsatisfiable",
        actual being not (range-of with stated being "bytes=100-120", width being 100).satisfiable
    evaluate is-true with label being "a backwards range is unsatisfiable",
        actual being not (range-of with stated being "bytes=50-20", width being 100).satisfiable
    evaluate is-true with label being "nonsense in a range is unsatisfiable",
        actual being not (range-of with stated being "bytes=abc-def", width being 100).satisfiable
    evaluate is-true with label being "a multi-range request falls back to the whole file",
        actual being not (range-of with stated being "bytes=0-9,20-29", width being 100).present

    value ranged-request is make-request with verb being request-method.Get, target being "/assets/app.css",
        fields being (set-field with fields being (no-headers with nothing), name being "Range", content being "bytes=0-5"),
        body being ""
    value partial is serve-static with root being "tests/public", path being "/assets/app.css",
        request being ranged-request, seconds being 60
    evaluate same-number with label being "a satisfiable range is answered 206", actual being partial.code, expected being 206
    evaluate same-number with label being "a range response holds just those bytes",
        actual being (nil.std.text::length with s being partial.body), expected being 6
    evaluate same-text with label being "a range response says which bytes",
        actual being (field-value with fields being partial.fields, name being "Content-Range"), expected being "bytes 0-5/31"
    evaluate same-text with label being "a range response advertises ranges",
        actual being (field-value with fields being partial.fields, name being "Accept-Ranges"), expected being "bytes"

    value bad-range is make-request with verb being request-method.Get, target being "/assets/app.css",
        fields being (set-field with fields being (no-headers with nothing), name being "Range", content being "bytes=9999-"),
        body being ""
    value refused-range is serve-static with root being "tests/public", path being "/assets/app.css",
        request being bad-range, seconds being 60
    evaluate same-number with label being "an unsatisfiable range is answered 416", actual being refused-range.code, expected being 416
    evaluate same-text with label being "a 416 names the real length",
        actual being (field-value with fields being refused-range.fields, name being "Content-Range"), expected being "bytes */31"

    evaluate same-text with label being "a full response advertises ranges",
        actual being (field-value with fields being (serve-static with root being "tests/public",
            path being "/assets/app.css", request being plain-get, seconds being 60).fields,
            name being "Accept-Ranges"), expected being "bytes"
    give nothing
end paragraph

middleware-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.middleware.chain"
    variable guarded is new-chain with nothing
    set guarded to with-guard with one-chain being guarded, kind being "require-host", setting being ""
    set guarded to with-guard with one-chain being guarded, kind being "body-limit", setting being "10"

    value hosted is make-request with verb being request-method.Get, target being "/",
        fields being (set-field with fields being (no-headers with nothing), name being "Host", content being "example.com"),
        body being ""
    evaluate is-true with label being "a well-formed request passes the guards",
        actual being not (run-guards with one-chain being guarded, request being hosted).stopped

    value hostless is make-request with verb being request-method.Get, target being "/",
        fields being (no-headers with nothing), body being ""
    value refused is run-guards with one-chain being guarded, request being hostless
    evaluate is-true with label being "a request with no Host is stopped", actual being refused.stopped
    evaluate same-number with label being "a missing Host is a 400", actual being refused.response.code, expected being 400

    value fat is make-request with verb being request-method.Post, target being "/",
        fields being (set-field with fields being (no-headers with nothing), name being "Host", content being "example.com"),
        body being "far more than ten bytes"
    value too-big is run-guards with one-chain being guarded, request being fat
    evaluate is-true with label being "an oversized body is stopped", actual being too-big.stopped
    evaluate same-number with label being "an oversized body is a 413", actual being too-big.response.code, expected being 413

    variable unwired is new-chain with nothing
    set unwired to with-guard with one-chain being unwired, kind being "no-such-guard", setting being ""
    value failed is run-guards with one-chain being unwired, request being hosted
    evaluate is-true with label being "an unwired guard fails closed", actual being failed.stopped
    evaluate same-number with label being "an unwired guard is a 500", actual being failed.response.code, expected being 500

    variable finishing is new-chain with nothing
    set finishing to with-finisher with one-chain being finishing, kind being "security-headers", setting being ""
    set finishing to with-finisher with one-chain being finishing, kind being "server-name", setting being "nil-web"
    set finishing to with-finisher with one-chain being finishing, kind being "header", setting being "X-Request-Id: abc"
    value finished is run-finishers with one-chain being finishing, response being (text-response with body being "ok")
    evaluate same-text with label being "nosniff is set",
        actual being (field-value with fields being finished.fields, name being "X-Content-Type-Options"), expected being "nosniff"
    evaluate same-text with label being "framing is denied",
        actual being (field-value with fields being finished.fields, name being "X-Frame-Options"), expected being "DENY"
    evaluate same-text with label being "a referrer policy is set",
        actual being (field-value with fields being finished.fields, name being "Referrer-Policy"), expected being "no-referrer-when-downgrade"
    evaluate same-text with label being "the server name is set",
        actual being (field-value with fields being finished.fields, name being "Server"), expected being "nil-web"
    evaluate same-text with label being "an arbitrary header is set",
        actual being (field-value with fields being finished.fields, name being "X-Request-Id"), expected being "abc"
    evaluate same-text with label being "the body is untouched", actual being finished.body, expected being "ok"

    variable unknown-finisher is new-chain with nothing
    set unknown-finisher to with-finisher with one-chain being unknown-finisher, kind being "no-such", setting being ""
    evaluate same-text with label being "an unwired finisher leaves the response alone",
        actual being (run-finishers with one-chain being unknown-finisher, response being (text-response with body being "ok")).body,
        expected being "ok"
    give nothing
end paragraph

listener-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.server.engine"
    !!! The framing decision, tested without a socket: how the loop knows a
    !!! request has fully arrived. Getting this wrong means either answering
    !!! half a request or waiting forever for a body that was never coming.
    value marker is (crlf with nothing) plus (crlf with nothing)
    evaluate is-true with label being "a bodyless request ends at the blank line",
        actual being (request-is-complete with message being "GET / HTTP/1.1" plus (crlf with nothing)
            plus "Host: x" plus marker)
    evaluate is-true with label being "a header section with no blank line is incomplete",
        actual being not (request-is-complete with message being "GET / HTTP/1.1" plus (crlf with nothing) plus "Host: x")
    evaluate is-true with label being "nothing at all is incomplete",
        actual being not (request-is-complete with message being "")
    evaluate is-true with label being "a bare-LF request is recognised",
        actual being (request-is-complete with message being "GET / HTTP/1.1" plus newline plus "Host: x"
            plus newline plus newline)

    value header-part is "POST /f HTTP/1.1" plus (crlf with nothing) plus "Content-Length: 9" plus marker
    evaluate is-true with label being "a declared body that has not arrived is incomplete",
        actual being not (request-is-complete with message being header-part plus "short")
    evaluate is-true with label being "a declared body that has arrived is complete",
        actual being (request-is-complete with message being header-part plus "123456789")
    evaluate is-true with label being "more body than declared is complete",
        actual being (request-is-complete with message being header-part plus "123456789extra")
    evaluate is-true with label being "Content-Length folds case like any field",
        actual being (request-is-complete with message being "POST /f HTTP/1.1" plus (crlf with nothing)
            plus "content-length: 2" plus marker plus "ab")
    evaluate is-true with label being "a Content-Length that is not a number does not stall the loop",
        actual being (request-is-complete with message being "POST /f HTTP/1.1" plus (crlf with nothing)
            plus "Content-Length: banana" plus marker)
    evaluate is-true with label being "a negative Content-Length does not stall the loop",
        actual being (request-is-complete with message being "POST /f HTTP/1.1" plus (crlf with nothing)
            plus "Content-Length: -5" plus marker)
    evaluate is-true with label being "an absurd Content-Length does not stall the loop",
        actual being (request-is-complete with message being "POST /f HTTP/1.1" plus (crlf with nothing)
            plus "Content-Length: 99999999999999999999" plus marker)

    evaluate same-text with label being "the startup line names a loopback address",
        actual being (address-text with host being "127.0.0.1", port being 8080), expected being "http://127.0.0.1:8080/"
    evaluate same-text with label being "an empty host is shown as every interface",
        actual being (address-text with host being "", port being 80), expected being "http://0.0.0.0:80/"

    !!! Binding is refused rather than raised, and the refusal says why. Port
    !!! zero is rejected by the intrinsic, so this needs no free port.
    value refused is start-engine with host being "127.0.0.1", port being 0, limit being 8
    evaluate is-true with label being "an impossible port does not bind", actual being not refused.live
    evaluate is-true with label being "a refusal to bind says why", actual being not (refused.complaint equals "")
    value named is start-engine with host being "example.com", port being 8080, limit being 8
    evaluate is-true with label being "binding does not resolve a name", actual being not named.live

    !!! A real bind, so the happy path is covered too, then released.
    variable bound is start-engine with host being "127.0.0.1", port being 18731, limit being 8
    evaluate is-true with label being "a free loopback port binds", actual being bound.live
    evaluate same-text with label being "a successful bind has no complaint", actual being bound.complaint, expected being ""
    evaluate same-number with label being "a fresh engine holds no connections", actual being bound.open-count, expected being 0
    evaluate same-number with label being "a fresh engine has served nothing", actual being bound.served-total, expected being 0
    value idle-pass is pump with server being bound, timeout being 10
    evaluate is-true with label being "a pass with nothing happening finds nothing", actual being not idle-pass.found
    evaluate same-number with label being "sweeping an empty engine closes nothing",
        actual being (sweep-idle with server being bound), expected being 0
    evaluate stop-engine with server being bound
    evaluate is-true with label being "a stopped engine is not live", actual being not bound.live
    variable again-bound is start-engine with host being "127.0.0.1", port being 18731, limit being 8
    evaluate is-true with label being "the port is free again after stopping", actual being again-bound.live
    evaluate stop-engine with server being again-bound

    !!! Keep-alive: 1.1 keeps unless told to close, 1.0 closes unless told to keep.
    evaluate is-true with label being "HTTP/1.1 keeps the connection by default",
        actual being (wants-keep-alive with message being "GET / HTTP/1.1" plus (crlf with nothing) plus "Host: x" plus marker)
    evaluate is-true with label being "HTTP/1.1 honours Connection: close",
        actual being not (wants-keep-alive with message being "GET / HTTP/1.1" plus (crlf with nothing)
            plus "Connection: close" plus marker)
    evaluate is-true with label being "HTTP/1.0 closes by default",
        actual being not (wants-keep-alive with message being "GET / HTTP/1.0" plus (crlf with nothing) plus "Host: x" plus marker)
    evaluate is-true with label being "HTTP/1.0 honours Connection: keep-alive",
        actual being (wants-keep-alive with message being "GET / HTTP/1.0" plus (crlf with nothing)
            plus "Connection: keep-alive" plus marker)
    evaluate is-true with label being "the Connection field folds case",
        actual being not (wants-keep-alive with message being "GET / HTTP/1.1" plus (crlf with nothing)
            plus "connection: Close" plus marker)
    give nothing
end paragraph

clock-tests returns nothing begin paragraph
    evaluate section with title being "nilweb.time.clock"
    !!! Every expectation below was generated from a calendar implementation
    !!! that is not this one, over leap days, century non-leap years, the
    !!! RFC's own example instant, and forty random instants. Calendar code
    !!! that is wrong one day in four years looks right in every test someone
    !!! writes in the other three, so the cases are chosen rather than typed.
    evaluate same-text with label being "http 0", actual being (http-date with at-ms being 0), expected being "Thu, 01 Jan 1970 00:00:00 GMT"
    evaluate same-text with label being "iso 0", actual being (iso-instant with at-ms being 0), expected being "1970-01-01T00:00:00Z"
    evaluate same-text with label being "log 0", actual being (log-date with at-ms being 0), expected being "01/Jan/1970:00:00:00 +0000"
    evaluate same-number with label being "weekday 0", actual being (civil-from-ms with at-ms being 0).weekday, expected being 4
    evaluate same-number with label being "round-trip 0", actual being (ms-from-http-date with stated being "Thu, 01 Jan 1970 00:00:00 GMT"), expected being 0
    evaluate same-text with label being "http 1", actual being (http-date with at-ms being 1), expected being "Thu, 01 Jan 1970 00:00:00 GMT"
    evaluate same-text with label being "iso 1", actual being (iso-instant with at-ms being 1), expected being "1970-01-01T00:00:00Z"
    evaluate same-text with label being "log 1", actual being (log-date with at-ms being 1), expected being "01/Jan/1970:00:00:00 +0000"
